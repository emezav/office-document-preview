{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run extension (isolated)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions",
        "${workspaceFolder}/private/samples"
      ]
    },
    {
      "name": "Run extension (with your other extensions)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/private/samples"
      ]
    },
    {
      "name": "Run extension (demo documents, for screenshots)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions",
        "${workspaceFolder}/private/demo"
      ]
    }
  ]
}
